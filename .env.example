# Keep the real token in .env only. Never commit or paste it into source code.
INSTAGRAM_ACCESS_TOKEN=replace-with-your-token

# Optional: leave blank and the app will resolve it from /me.
INSTAGRAM_USER_ID=

# Printed on every poem slide. The photograph slide remains untouched.
INSTAGRAM_HANDLE=@handle-

# Start an HTTPS tunnel to the media-only server on port 8001, then paste its URL.
PUBLIC_MEDIA_BASE_URL=https://replace-with-your-tunnel.example

# Defaults track the current Instagram API version used by this prototype.
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# Local media-only server. Do not expose the app/control server on port 8000.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8001
MEDIA_DIR=instance/media
